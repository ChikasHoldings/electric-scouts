# ═══════════════════════════════════════════════════════════
# Electric Scouts — environment configuration
#
# Copy to .env.local for development, and set the same values in Vercel
# (Settings → Environment Variables) for deployment.
#
# Only the VITE_ prefixed values reach the browser. Everything else is
# server-side only and must never be given a VITE_ prefix, because that would
# publish it in the client bundle.
# ═══════════════════════════════════════════════════════════

# ─── Supabase — required ───────────────────────────────────
# Project → Settings → API. The anon key is public by design; row-level
# security is what protects the data behind it.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Server-side only. Bypasses row-level security entirely, so it is used by the
# API routes and never by the browser. Treat it like a database password.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── Email (Resend) — required for every outbound email ────
# Without this: no lead welcome, no comparison results, no follow-up nurture,
# no admin notifications, and no weekly report. Lead capture still works.
RESEND_API_KEY=re_your_resend_key

# The verified sender. Must be on a domain verified in Resend or delivery fails.
FROM_EMAIL=noreply@electricscouts.com

# Who receives new-lead, concierge, business-quote and weekly-report
# notifications. Comma-separated. Empty means nobody is told anything arrived.
ADMIN_EMAILS=you@example.com,someone-else@example.com

# ─── Site URL — required for correct links in email ────────
# Used to build absolute links in emails and outbound tracking URLs. A wrong
# value sends customers to the wrong host from their inbox.
APP_BASE_URL=https://www.electricscouts.com

# ─── Scheduled jobs — required for the nurture sequence ────
# Vercel Cron presents this as `Authorization: Bearer $CRON_SECRET`. The
# scheduled endpoints fail closed without it: the nightly follow-up pass and
# the weekly report will not run, and will not be reachable by anyone else
# either. Generate with: openssl rand -hex 32
CRON_SECRET=generate-a-long-random-string

# ─── OpenAI — optional ─────────────────────────────────────
# Powers bill data extraction in the Bill Analyzer (api/extract-data.js and
# api/invoke-llm.js). Without it the analyzer reports that automatic reading is
# unavailable and the visitor enters their usage by hand; nothing else on the
# site depends on it.
OPENAI_API_KEY=sk-your-openai-key
